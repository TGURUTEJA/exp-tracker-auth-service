{
  "info": {
    "name": "All APIs with Global JWT Auto-Refresh",
    "description": "Collection with JWT auto-refresh applied globally to ALL requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "/*",
          " * COLLECTION-LEVEL Pre-request Script",
          " * Applies JWT auto-refresh to ALL requests in this collection",
          " */",
          "",
          "let jwt = pm.environment.get(\"jwt\");",
          "",
          "function decodeJWT(token) {",
          "    try {",
          "        const parts = token.split('.');",
          "        if (parts.length !== 3) {",
          "            console.log(\"⚠ Invalid JWT format\");",
          "            return null;",
          "        }",
          "        ",
          "        let payload = parts[1];",
          "        const padding = 4 - (payload.length % 4);",
          "        if (padding !== 4) {",
          "            payload += '='.repeat(padding);",
          "        }",
          "        ",
          "        const decoded = atob(payload);",
          "        const parsed = JSON.parse(decoded);",
          "        return parsed;",
          "    } catch (e) {",
          "        console.log(\"✗ Error decoding JWT: \" + e.message);",
          "        return null;",
          "    }",
          "}",
          "",
          "function isJWTExpired(jwtPayload) {",
          "    if (!jwtPayload || !jwtPayload.exp) {",
          "        console.log(\"⚠ JWT payload missing or no expiration claim\");",
          "        return true;",
          "    }",
          "    ",
          "    const expirationTime = jwtPayload.exp * 1000;",
          "    const currentTime = Date.now();",
          "    const timeUntilExpiry = expirationTime - currentTime;",
          "    const minutesRemaining = Math.floor(timeUntilExpiry / 60000);",
          "    ",
          "    console.log(\"📋 JWT expiration check:\");",
          "    console.log(\"   - Expires at: \" + new Date(expirationTime).toLocaleString());",
          "    console.log(\"   - Current time: \" + new Date(currentTime).toLocaleString());",
          "    console.log(\"   - Time remaining: \" + minutesRemaining + \" minutes\");",
          "    ",
          "    if (timeUntilExpiry < 60000) {",
          "        console.log(\"⏰ JWT is expired or about to expire!\");",
          "        return true;",
          "    }",
          "    ",
          "    console.log(\"✓ JWT is still valid\");",
          "    return false;",
          "}",
          "",
          "function generateNewJWT() {",
          "    console.log(\"🔄 Generating new JWT...\");",
          "    ",
          "    const testJwtEndpoint = pm.environment.get(\"base_url\") + \"/api/auth/test-jwt-generator\";",
          "    const testPayload = {",
          "        \"sub\": \"JWTAUth\",",
          "        \"role\": \"USER\",",
          "        \"iss\": \"auth-service\",",
          "        \"password_reset_token\": false,",
          "        \"ID\": pm.environment.get(\"user_id\") || 1",
          "    };",
          "    ",
          "    pm.sendRequest({",
          "        url: testJwtEndpoint,",
          "        method: 'POST',",
          "        header: {",
          "            'Content-Type': 'application/json'",
          "        },",
          "        body: {",
          "            mode: 'raw',",
          "            raw: JSON.stringify(testPayload)",
          "        }",
          "    }, function(err, response) {",
          "        if (err) {",
          "            console.log(\"✗ Error generating JWT: \" + err.message);",
          "            return;",
          "        }",
          "        ",
          "        if (response.code === 200) {",
          "            try {",
          "                let responseData = response.json();",
          "                if (responseData.token && !responseData.error) {",
          "                    pm.environment.set(\"jwt\", responseData.token);",
          "                    console.log(\"✓ New JWT generated and set globally\");",
          "                    console.log(\"✓ Token length: \" + responseData.token.length + \" characters\");",
          "                } else {",
          "                    console.log(\"✗ Failed to generate JWT: \" + responseData.message);",
          "                }",
          "            } catch (e) {",
          "                console.log(\"✗ Error parsing response: \" + e.message);",
          "            }",
          "        } else {",
          "            console.log(\"✗ JWT generation returned: \" + response.code);",
          "        }",
          "    });",
          "}",
          "",
          "// Main Logic - Runs for EVERY request in this collection",
          "console.log(\"\\n🔐 [COLLECTION] JWT Expiry Check - Applying to all requests\");",
          "console.log(\"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\");",
          "",
          "if (!jwt) {",
          "    console.log(\"⚠ No JWT found - requesting generation...\");",
          "    generateNewJWT();",
          "} else {",
          "    const decodedJWT = decodeJWT(jwt);",
          "    ",
          "    if (decodedJWT) {",
          "        const isExpired = isJWTExpired(decodedJWT);",
          "        ",
          "        if (isExpired) {",
          "            console.log(\"⏸ JWT expired - requesting refresh...\");",
          "            generateNewJWT();",
          "        } else {",
          "            console.log(\"✓ JWT valid - proceeding with request\");",
          "        }",
          "    } else {",
          "        console.log(\"✗ Could not decode JWT\");",
          "    }",
          "}",
          "",
          "console.log(\"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\\n\");"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Generate Test JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sub\": \"JWTAUth\",\n  \"role\": \"USER\",\n  \"iss\": \"auth-service\",\n  \"password_reset_token\": false,\n  \"ID\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/test-jwt-generator",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "test-jwt-generator"
          ]
        }
      }
    },
    {
      "name": "2. Create Category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "access_token={{jwt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryName\": \"Electronics\",\n  \"description\": \"Electronic products and gadgets\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/App/category/create_category",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "App",
            "category",
            "create_category"
          ]
        }
      }
    },
    {
      "name": "3. Get Categories",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{jwt}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/App/category/get_categories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "App",
            "category",
            "get_categories"
          ]
        }
      }
    },
    {
      "name": "4. Update Category",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "access_token={{jwt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": 1,\n  \"categoryName\": \"Updated Electronics\",\n  \"description\": \"Updated description\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/App/category/update_category",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "App",
            "category",
            "update_category"
          ]
        }
      }
    },
    {
      "name": "5. Delete Category",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{jwt}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/App/category/delete_category?categoryId=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "App",
            "category",
            "delete_category"
          ],
          "query": [
            {
              "key": "categoryId",
              "value": "1"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "jwt",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    }
  ]
}

