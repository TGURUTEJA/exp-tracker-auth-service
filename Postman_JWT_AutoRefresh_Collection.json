{
  "info": {
    "name": "Auth & Categories - JWT Auto-Refresh",
    "description": "Postman collection with JWT generation and auto-refresh on expiry",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Generate Test JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let responseData = pm.response.json();",
              "",
              "if (pm.response.code === 200 && !responseData.error) {",
              "    if (responseData.token) {",
              "        pm.environment.set(\"jwt\", responseData.token);",
              "        console.log(\"✓ JWT token successfully set in environment variable: jwt\");",
              "        console.log(\"Token length: \" + responseData.token.length + \" characters\");",
              "    } else {",
              "        console.log(\"⚠ Token not found in response body\");",
              "    }",
              "    ",
              "    if (responseData.ID) {",
              "        pm.environment.set(\"user_id\", responseData.ID);",
              "        console.log(\"✓ User ID set in environment variable: user_id (\" + responseData.ID + \")\");",
              "    }",
              "} else {",
              "    console.log(\"✗ Error generating JWT: \" + responseData.message);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sub\": \"JWTAUth\",\n  \"role\": \"USER\",\n  \"iss\": \"auth-service\",\n  \"password_reset_token\": false,\n  \"ID\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/test-jwt-generator",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "test-jwt-generator"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Create Category (with JWT Auto-Refresh)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let jwt = pm.environment.get(\"jwt\");",
              "",
              "function decodeJWT(token) {",
              "    try {",
              "        const parts = token.split('.');",
              "        if (parts.length !== 3) {",
              "            console.log(\"⚠ Invalid JWT format\");",
              "            return null;",
              "        }",
              "        ",
              "        let payload = parts[1];",
              "        ",
              "        const padding = 4 - (payload.length % 4);",
              "        if (padding !== 4) {",
              "            payload += '='.repeat(padding);",
              "        }",
              "        ",
              "        const decoded = atob(payload);",
              "        const parsed = JSON.parse(decoded);",
              "        ",
              "        return parsed;",
              "    } catch (e) {",
              "        console.log(\"✗ Error decoding JWT: \" + e.message);",
              "        return null;",
              "    }",
              "}",
              "",
              "function isJWTExpired(jwtPayload) {",
              "    if (!jwtPayload || !jwtPayload.exp) {",
              "        console.log(\"⚠ JWT payload missing or no expiration claim\");",
              "        return true;",
              "    }",
              "    ",
              "    const expirationTime = jwtPayload.exp * 1000;",
              "    const currentTime = Date.now();",
              "    const timeUntilExpiry = expirationTime - currentTime;",
              "    const minutesRemaining = Math.floor(timeUntilExpiry / 60000);",
              "    ",
              "    console.log(\"📋 JWT expiration check:\");",
              "    console.log(\"   - Expires at: \" + new Date(expirationTime).toLocaleString());",
              "    console.log(\"   - Current time: \" + new Date(currentTime).toLocaleString());",
              "    console.log(\"   - Time remaining: \" + minutesRemaining + \" minutes\");",
              "    ",
              "    if (timeUntilExpiry < 60000) {",
              "        console.log(\"⏰ JWT is expired or about to expire!\");",
              "        return true;",
              "    }",
              "    ",
              "    console.log(\"✓ JWT is still valid\");",
              "    return false;",
              "}",
              "",
              "function generateNewJWT(callback) {",
              "    console.log(\"🔄 Generating new JWT...\");",
              "    ",
              "    const testJwtEndpoint = pm.environment.get(\"base_url\") + \"/api/auth/test-jwt-generator\";",
              "    ",
              "    const testPayload = {",
              "        \"sub\": \"JWTAUth\",",
              "        \"role\": \"USER\",",
              "        \"iss\": \"auth-service\",",
              "        \"password_reset_token\": false,",
              "        \"ID\": pm.environment.get(\"user_id\") || 1",
              "    };",
              "    ",
              "    pm.sendRequest({",
              "        url: testJwtEndpoint,",
              "        method: 'POST',",
              "        header: {",
              "            'Content-Type': 'application/json'",
              "        },",
              "        body: {",
              "            mode: 'raw',",
              "            raw: JSON.stringify(testPayload)",
              "        }",
              "    }, function(err, response) {",
              "        if (err) {",
              "            console.log(\"✗ Error generating JWT: \" + err.message);",
              "            return;",
              "        }",
              "        ",
              "        if (response.code === 200) {",
              "            let responseData = {};",
              "            try {",
              "                responseData = response.json();",
              "            } catch (e) {",
              "                console.log(\"✗ Error parsing response: \" + e.message);",
              "                return;",
              "            }",
              "            ",
              "            if (responseData.token && !responseData.error) {",
              "                pm.environment.set(\"jwt\", responseData.token);",
              "                console.log(\"✓ New JWT generated and set in environment\");",
              "                console.log(\"✓ Token length: \" + responseData.token.length + \" characters\");",
              "                callback(true);",
              "            } else {",
              "                console.log(\"✗ Failed to generate JWT: \" + responseData.message);",
              "                callback(false);",
              "            }",
              "        } else {",
              "            console.log(\"✗ JWT generation endpoint returned: \" + response.code);",
              "            callback(false);",
              "        }",
              "    });",
              "}",
              "",
              "console.log(\"\\n🔐 JWT Expiry Check Pre-request Script\");",
              "console.log(\"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\");",
              "",
              "if (!jwt) {",
              "    console.log(\"⚠ No JWT found in environment variable 'jwt'\");",
              "    console.log(\"⏸ Requesting JWT generation...\");",
              "    ",
              "    pm.environment.set(\"_jwt_check_pending\", true);",
              "    generateNewJWT(function(success) {",
              "        pm.environment.set(\"_jwt_check_pending\", false);",
              "    });",
              "} else {",
              "    const decodedJWT = decodeJWT(jwt);",
              "    ",
              "    if (decodedJWT) {",
              "        const isExpired = isJWTExpired(decodedJWT);",
              "        ",
              "        if (isExpired) {",
              "            console.log(\"⏸ Requesting JWT refresh...\");",
              "            pm.environment.set(\"_jwt_check_pending\", true);",
              "            ",
              "            generateNewJWT(function(success) {",
              "                pm.environment.set(\"_jwt_check_pending\", false);",
              "            });",
              "        } else {",
              "            console.log(\"✓ Proceeding with request using current JWT\");",
              "        }",
              "    } else {",
              "        console.log(\"✗ Could not decode JWT\");",
              "    }",
              "}",
              "",
              "console.log(\"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\\n\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "access_token={{jwt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryName\": \"Electronics\",\n  \"description\": \"Electronic products and gadgets\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/App/category/create_category",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "App",
            "category",
            "create_category"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "jwt",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    }
  ]
}

